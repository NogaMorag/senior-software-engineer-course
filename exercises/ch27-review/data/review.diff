diff --git a/internal/docs/handler.go b/internal/docs/handler.go
new file mode 100644
index 0000000..f711d3f
--- /dev/null
+++ b/internal/docs/handler.go
@@ -0,0 +1,86 @@
+package docs
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"strconv"
+
+	"example.com/docsvc/internal/auth"
+)
+
+// Store is what the handlers need from the repository.
+type Store interface {
+	List(ctx context.Context, tenantID, sort string, limit int) ([]Document, error)
+	Get(ctx context.Context, id string) (Document, error)
+}
+
+// cache keeps documents that were read recently, to save database round trips.
+var cache = map[string]Document{}
+
+// Handler serves the documents API.
+type Handler struct {
+	Store Store
+	Log   *slog.Logger
+}
+
+// Register adds the routes.
+func (h *Handler) Register(mux *http.ServeMux) {
+	mux.HandleFunc("GET /v1/documents", h.ListDocumentsHandler)
+	mux.HandleFunc("GET /v1/documents/{id}", h.GetDocumentHandler)
+}
+
+// ListDocumentsHandler returns the caller's documents.
+func (h *Handler) ListDocumentsHandler(w http.ResponseWriter, r *http.Request) {
+	id, ok := auth.From(r.Context())
+	if !ok {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	h.Log.InfoContext(r.Context(), "list documents",
+		slog.String("tenant", id.Tenant), slog.String("auth", r.Header.Get("Authorization")))
+
+	sort := r.URL.Query().Get("sort")
+	if sort == "" {
+		sort = "created_at"
+	}
+	limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
+	if limit == 0 {
+		limit = 50
+	}
+	docs, err := h.Store.List(r.Context(), id.Tenant, sort, limit)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(map[string]any{"items": docs})
+}
+
+// GetDocumentHandler returns one document.
+func (h *Handler) GetDocumentHandler(w http.ResponseWriter, r *http.Request) {
+	if _, ok := auth.From(r.Context()); !ok {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	docId := r.PathValue("id")
+	if d, ok := cache[docId]; ok {
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(d)
+		return
+	}
+	d, err := h.Store.Get(r.Context(), docId)
+	if err == sql.ErrNoRows {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	cache[docId] = d
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(d)
+}
diff --git a/internal/docs/handler_test.go b/internal/docs/handler_test.go
