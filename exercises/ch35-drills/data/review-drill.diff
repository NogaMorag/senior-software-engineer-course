@@ -0,0 +1,34 @@
+package inbox
+
+import (
+	"sync"
+	"time"
+)
+
+// Dedupe remembers event ids we have already handled, so that a retried delivery
+// is not processed twice.
+type Dedupe struct {
+	mu     sync.Mutex
+	seen   map[string]time.Time
+	window time.Duration
+	Hits   int
+}
+
+func NewDedupe(window time.Duration) *Dedupe {
+	return &Dedupe{seen: map[string]time.Time{}, window: window}
+}
+
+// Seen reports whether id was seen within the window, and records it.
+func (d *Dedupe) Seen(id string) bool {
+	d.mu.Lock()
+	at, ok := d.seen[id]
+	d.mu.Unlock()
+	if ok && time.Since(at) < d.window {
+		d.Hits++
+		return true
+	}
+	d.mu.Lock()
+	d.seen[id] = time.Now()
+	d.mu.Unlock()
+	return false
+}
diff --git a/internal/inbox/dedupe_test.go b/internal/inbox/dedupe_test.go
new file mode 100644
index 0000000..1f24008
--- /dev/null
+++ b/internal/inbox/dedupe_test.go
@@ -0,0 +1,20 @@
+package inbox
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDedupe(t *testing.T) {
+	d := NewDedupe(time.Minute)
+	if d.Seen("evt_1") {
+		t.Fatal("first delivery reported as seen")
+	}
+	if !d.Seen("evt_1") {
+		t.Fatal("second delivery not reported as seen")
+	}
+	time.Sleep(10 * time.Millisecond)
+	if d.Seen("evt_2") {
+		t.Log("evt_2 should be new")
+	}
+}
