# Remote state in the bucket above, with S3-native locking (use_lockfile).
# To use it in another configuration: copy this file there as backend.tf, put
# in your bucket name, and run terraform init -migrate-state.
terraform {
  backend "s3" {
    bucket       = "senior-course-tfstate-change-me"
    key          = "ch22/terraform.tfstate"
    region       = "eu-central-1"
    use_lockfile = true # a lock object next to the state; DynamoDB locking is deprecated
    encrypt      = true
  }
}
