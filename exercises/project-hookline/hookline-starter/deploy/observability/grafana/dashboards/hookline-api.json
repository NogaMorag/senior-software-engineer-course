{
 "uid": "hookline-api",
 "title": "Hookline API",
 "tags": [
  "hookline",
  "red",
  "slo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "RED: hookline-api, by route",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Rate: requests per second by route",
   "description": "R of RED: every request the API answered, per route.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"hookline-api\"}[$__rate_interval]))",
     "legendFormat": "{{http_route}}",
     "exemplar": false
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Errors: share answered 5xx, and 429 and 503 per second",
   "description": "E of RED. 5xx is the availability SLI; 429 is a tenant over its limit (N5); 503 is shedding (N6).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"hookline-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"hookline-api\"}[$__rate_interval]))",
     "legendFormat": "5xx share",
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"hookline-api\",http_response_status_code=\"429\"}[$__rate_interval]))",
     "legendFormat": "429 per second",
     "exemplar": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"hookline-api\",http_response_status_code=\"503\"}[$__rate_interval]))",
     "legendFormat": "503 per second",
     "exemplar": false
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Duration: p50, p95, p99 of POST /v1/events (route /v1/events)",
   "description": "D of RED for ingest. Target N1: p99 under 200 ms (measured by k6 in M9); the alerting SLI uses the 250 ms bucket.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"hookline-api\",http_route=\"/v1/events\",http_request_method=\"POST\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"hookline-api\",http_route=\"/v1/events\",http_request_method=\"POST\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "exemplar": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"hookline-api\",http_route=\"/v1/events\",http_request_method=\"POST\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "exemplar": false
    }
   ]
  },
  {
   "id": 5,
   "type": "row",
   "title": "SLO: hookline-api",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Availability, 30-day objective",
   "description": "job:slo_availability:objective",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "job:slo_availability:objective{job=\"hookline-api\"}"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "5xx share, last hour",
   "description": "The 1h window of the burn-rate alert.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 10,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "job:slo_errors_per_request:ratio_rate1h{job=\"hookline-api\"}"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Slow share (over 250 ms), last hour",
   "description": "The 1h window of the latency burn-rate alert.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "job:slo_slow_requests:ratio_rate1h{job=\"hookline-api\"}"
    }
   ]
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Rate limiter failures served open, last hour",
   "description": "Should be 0: anything else means Redis is unreachable (runbook RateLimiterFailingOpen).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 10,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(hookline_ratelimit_errors_total[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 10,
   "type": "row",
   "title": "Ingest",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Events per second: new and replayed",
   "description": "Replayed means a client retried with the same Idempotency-Key and got the original event back.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(hookline_ingest_events_total[$__rate_interval]))",
     "legendFormat": "{{result}}",
     "exemplar": false
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Goroutines and memory in use",
   "description": "USE for the API process: saturation shows up here before latency does.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(go_goroutine_count{job=\"hookline-api\"})",
     "legendFormat": "goroutines",
     "exemplar": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(go_memory_used_bytes{job=\"hookline-api\"}) / 1e6",
     "legendFormat": "memory MB",
     "exemplar": false
    }
   ]
  }
 ]
}